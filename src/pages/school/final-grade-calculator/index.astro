---
import CalcShell from '../../../components/calc/CalcShell.astro';
import Field from '../../../components/calc/Field.astro';
import Presets from '../../../components/calc/Presets.astro';
import Stat from '../../../components/calc/Stat.astro';
import Steps from '../../../components/calc/Steps.astro';
import Tabs from '../../../components/calc/Tabs.astro';
import CalculatorLayout from '../../../layouts/CalculatorLayout.astro';

const faqs = [
  {
    q: 'How do I calculate what I need on my final exam?',
    a: 'Subtract the part of the course grade you have already earned from the grade you want, then divide by the weight of the final. With 85% so far, a final worth 30% and a target of 90%, you have 85 × 0.70 = 59.5 points, need 90 − 59.5 = 30.5 more, and 30.5 ÷ 0.30 = 101.7% on the final.',
  },
  {
    q: 'What does it mean if I need more than 100%?',
    a: 'It means the target grade can’t be reached with the final alone, unless there is extra credit or your teacher curves the grades. The calculator shows the highest course grade you can still reach, which is what you would get with 100% on the final.',
  },
  {
    q: 'What if my final exam is worth 20%, 25% or 40%?',
    a: 'Enter that percentage in "Final exam weight". The lighter the final, the harder it is to move your grade: a final worth 20% can shift your course grade by at most 20 points, while one worth 40% can shift it by 40.',
  },
  {
    q: 'My class uses points, not percentages. Can I still use this?',
    a: 'Yes. Divide your points so far by the points possible so far to get your current percentage, and divide the points the final is worth by the total points in the course to get its weight. For example, 170 of 200 points is 85%, and a 150-point final in a 500-point course is worth 30%.',
  },
  {
    q: 'Why is my teacher’s grade different?',
    a: 'Teachers may round grades, drop the lowest score, weight categories such as homework and tests differently, or use different letter cut-offs. The calculator assumes your current grade already reflects everything except the final. Your syllabus has the exact rules.',
  },
];
---

<CalculatorLayout
  slug="final-grade-calculator"
  intro="Find the score you need on your final exam to reach the course grade you want, or see what grade a final score will give you."
  faqs={faqs}
  disclaimer="Schools weight and round grades in different ways, and letter cut-offs vary. Your syllabus or teacher has the final word."
>
  <CalcShell name="Final Grade Calculator">
    <Tabs
      slot="top"
      legend="What do you want to find?"
      options={[
        { value: 'needed', label: 'Score I need on the final' },
        { value: 'course', label: 'Grade from a final score' },
      ]}
    />

    <Field name="current" label="Current grade" suffix="%" value="85" hint="Your grade before the final." />
    <Field name="weight" label="Final exam weight" suffix="%" value="30" hint="How much of the course grade the final counts for." />
    <Field name="target" label="Grade you want in the course" suffix="%" value="87" mode="needed" />
    <Presets
      field="target"
      label="Letter grade targets"
      options={[
        { value: '90', label: 'A (90%)' },
        { value: '80', label: 'B (80%)' },
        { value: '70', label: 'C (70%)' },
        { value: '60', label: 'D (60%)' },
      ]}
      mode="needed"
    />
    <Field name="final" label="Score on the final" suffix="%" value="80" mode="course" />

    <Fragment slot="result">
      <div class="stats">
        <Stat label="Score needed on the final" out="main" primary sub />
        <Stat label="With 100% on the final" out="best" sub />
        <Stat label="With 0% on the final" out="worst" sub />
        <Stat label="Already earned" out="earned" sub />
      </div>
      <p class="result-note" data-out="note" hidden></p>
      <div class="result-split">
        <div class="result-section">
          <h3>Score needed for each letter grade</h3>
          <div class="result-table-wrap">
            <table class="result-table">
              <thead>
                <tr><th>Course grade</th><th>Final score needed</th><th>Reachable?</th></tr>
              </thead>
              <tbody data-table="letters"></tbody>
            </table>
          </div>
          <h3 class="mt-6">Course grade for every final score</h3>
          <div data-chart="line"></div>
          <p class="chart-note">The line shows your course grade for each final score; the dashed line is your target.</p>
        </div>
        <Steps />
      </div>
    </Fragment>
  </CalcShell>

  <Fragment slot="content">
    <h2>How to use the final grade calculator</h2>
    <ol>
      <li>Enter your current grade in the class as a percentage.</li>
      <li>Enter how much the final exam counts toward the course grade, for example 30%.</li>
      <li>Enter the course grade you want, or tap a letter grade.</li>
      <li>Read the score you need. The table shows the score needed for an A, B, C and D at the same time.</li>
    </ol>
    <p>
      Already know your final score, or want to try "what if" scores? Switch to "Grade from a final score".
    </p>

    <h2>The final grade formula</h2>
    <p>Your course grade is a weighted average of the work before the final and the final itself:</p>
    <p><strong>Course grade = current grade × (1 − final weight) + final score × final weight</strong></p>
    <p>Rearranging it gives the score you need:</p>
    <p><strong>Final score needed = (target − current grade × (1 − final weight)) ÷ final weight</strong></p>
    <p>Weights are used as decimals, so a final worth 30% is 0.30.</p>

    <h2>Worked example</h2>
    <p>Maya has 85% in chemistry. The final is worth 30%, and she wants at least a B+ (87%).</p>
    <ul>
      <li>Points already earned: 85 × (1 − 0.30) = 59.5 out of the 70 available before the final.</li>
      <li>Points still needed: 87 − 59.5 = 27.5.</li>
      <li>Score needed: 27.5 ÷ 0.30 = <strong>91.7%</strong> on the final.</li>
      <li>An A (90%) would need (90 − 59.5) ÷ 0.30 = 101.7%, so it is out of reach without extra credit.</li>
      <li>Even with 0% on the final she would finish with 59.5%.</li>
    </ul>

    <h2>Finding your current grade from weighted categories</h2>
    <p>
      If your class is graded by category, work out your current grade from the categories that are already finished. Say
      homework is worth 20%, quizzes 20% and tests 30%, with the final worth the remaining 30%, and your averages are 95%,
      80% and 82%:
    </p>
    <ul>
      <li>Weighted points so far: 95 × 0.20 + 80 × 0.20 + 82 × 0.30 = 19 + 16 + 24.6 = 59.6.</li>
      <li>Weight completed so far: 0.20 + 0.20 + 0.30 = 0.70.</li>
      <li>Current grade: 59.6 ÷ 0.70 = <strong>85.1%</strong>. Enter this with a final weight of 30%.</li>
    </ul>

    <h2>Common US letter grade scale</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Letter</th><th>Percentage</th><th>Letter</th><th>Percentage</th></tr>
        </thead>
        <tbody>
          <tr><td>A</td><td>90–100%</td><td>C</td><td>70–79%</td></tr>
          <tr><td>B</td><td>80–89%</td><td>D</td><td>60–69%</td></tr>
          <tr><td colspan="2">F: below 60%</td><td colspan="2">Plus and minus grades vary by school</td></tr>
        </tbody>
      </table>
    </div>
  </Fragment>
</CalculatorLayout>

<script>
  import { courseGrade, finalGradeNeeded, LETTER_CUTOFFS, letterFor } from '../../../scripts/calculators/final-grade';
  import { formatNumber } from '../../../scripts/lib/format';
  import { lineChart } from '../../../scripts/ui/chart';
  import { out, setupCalculator, steps, table, toggle } from '../../../scripts/ui/calculator';

  const p = (n: number, d = 2) => `${formatNumber(n, d)}%`;

  setupCalculator((read) => {
    const mode = read.choice('mode');
    const current = read.number('current', { label: 'your current grade', min: 0, max: 200 });
    const weight = read.number('weight', { label: 'the final exam weight', min: 0, above: true, max: 100 });
    toggle('[data-out="note"]', false);

    const lettersTable = (cur: number, w: number) =>
      table(
        'letters',
        LETTER_CUTOFFS.map((c) => {
          const r = finalGradeNeeded(cur, c.min, w);
          const reach = r.status === 'already-secured' ? 'Already secured' : r.status === 'out-of-reach' ? 'Not without extra credit' : 'Yes';
          return [`${c.letter} (${c.min}%)`, r.status === 'already-secured' ? '0%' : p(r.needed, 1), reach];
        }),
      );

    if (mode === 'course') {
      const final = read.number('final', { label: 'the final score', min: 0, max: 200 });
      if (!read.ok || current === null || weight === null || final === null) return null;
      const grade = courseGrade(current, final, weight);
      const fromCurrent = current * (1 - weight / 100);
      const fromFinal = final * (weight / 100);
      out('main-label', 'Course grade');
      out('main', p(grade));
      out('main-sub', `Letter grade ${letterFor(grade)} on a standard scale`);
      out('best', p(courseGrade(current, 100, weight)));
      out('best-sub', 'Highest possible');
      out('worst', p(courseGrade(current, 0, weight)));
      out('worst-sub', 'Lowest possible');
      out('earned', `${formatNumber(fromFinal, 2)} pts`);
      out('earned-label', 'Points from the final');
      out('earned-sub', `plus ${formatNumber(fromCurrent, 2)} from work so far`);
      lettersTable(current, weight);
      lineChart(document.querySelector('[data-chart="line"]'), {
        y0: courseGrade(current, 0, weight),
        y100: courseGrade(current, 100, weight),
        target: grade,
        point: final,
        xLabel: 'Final exam score (%)',
        yLabel: 'Course grade (%)',
      });
      steps([
        ['Work before the final counts for (100 − weight)%', `${formatNumber(current)} × ${formatNumber(1 - weight / 100, 4)} = ${formatNumber(fromCurrent, 2)} points`],
        ['The final counts for its weight', `${formatNumber(final)} × ${formatNumber(weight / 100, 4)} = ${formatNumber(fromFinal, 2)} points`],
        ['Add them for the course grade', `${formatNumber(fromCurrent, 2)} + ${formatNumber(fromFinal, 2)} = ${p(grade)}`],
      ]);
      return {
        announce: `Your course grade would be ${p(grade, 1)}.`,
        copy: `Current ${p(current)}, final ${p(final)} worth ${p(weight)}: course grade ${p(grade)} (${letterFor(grade)})`,
      };
    }

    const target = read.number('target', { label: 'the grade you want', min: 0, max: 200 });
    if (!read.ok || current === null || weight === null || target === null) return null;
    const r = finalGradeNeeded(current, target, weight);

    out('main-label', 'Score needed on the final');
    out('main', r.status === 'already-secured' ? '0%' : p(r.needed));
    out(
      'main-sub',
      r.status === 'possible' ? `to finish with ${p(target)}` : r.status === 'already-secured' ? `You'll finish with at least ${p(target)} whatever you score` : 'More than 100%: out of reach without extra credit',
    );
    out('best', p(r.withPerfect));
    out('best-sub', `Letter grade ${letterFor(r.withPerfect)}`);
    out('worst', p(r.withZero));
    out('worst-sub', `Letter grade ${letterFor(r.withZero)}`);
    out('earned-label', 'Already earned');
    out('earned', `${formatNumber(r.fromCurrent, 2)} pts`);
    out('earned-sub', `of ${formatNumber(100 - weight, 2)} possible before the final`);
    if (r.status === 'out-of-reach') {
      out('note', `You would need ${p(r.needed)} on the final. The highest course grade you can reach is ${p(r.withPerfect)}.`);
      toggle('[data-out="note"]', true);
    }
    document.querySelector('[data-out="note"]')?.classList.toggle('is-warning', r.status === 'out-of-reach');
    lettersTable(current, weight);
    lineChart(document.querySelector('[data-chart="line"]'), {
      y0: r.withZero,
      y100: r.withPerfect,
      target,
      point: r.status === 'possible' ? r.needed : undefined,
      xLabel: 'Final exam score (%)',
      yLabel: 'Course grade (%)',
    });
    steps([
      ['Points already earned = current × (1 − weight)', `${formatNumber(current)} × ${formatNumber(1 - weight / 100, 4)} = ${formatNumber(r.fromCurrent, 2)}`],
      ['Points still needed = target − points earned', `${formatNumber(target)} − ${formatNumber(r.fromCurrent, 2)} = ${formatNumber(target - r.fromCurrent, 2)}`],
      ['Score needed = points needed ÷ weight', `${formatNumber(target - r.fromCurrent, 2)} ÷ ${formatNumber(weight / 100, 4)} = ${p(r.needed)}`],
    ]);
    return {
      announce: r.status === 'out-of-reach' ? `You would need ${p(r.needed, 1)}, which is more than 100 percent.` : `You need ${p(Math.max(0, r.needed), 1)} on the final.`,
      copy: `Current ${p(current)}, final worth ${p(weight)}, target ${p(target)}: need ${p(r.needed)} on the final`,
    };
  });
</script>
