---
import SiteSearch from '../components/SiteSearch.astro';
import { calculatorUrl, calculatorsIn, categories, categoryUrl } from '../data/calculators';
import BaseLayout from '../layouts/BaseLayout.astro';
import { organizationSchema, websiteSchema } from '../lib/schema';

const title = 'Free Online Calculators | Infinite Calculators';
const description =
  'Free online calculators for time cards, dates, concrete, paint, tips, sales tax, grades, zakat and Easter. Instant answers in your browser, no sign-up.';
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[organizationSchema(), websiteSchema()]}
  showHeaderSearch={false}
>
  <div class="wrap">
    <div class="max-w-2xl pt-12 pb-12 sm:pt-16">
      <h1 class="text-4xl sm:text-[2.75rem]">Free online calculators</h1>
      <p class="mt-4 text-lg text-muted">
        Time cards, dates, home projects, money, school grades and religious calendars. Each calculator
        explains its formula and works through an example, so you can check the answer yourself.
      </p>
      <div class="mt-7">
        <SiteSearch id="home-search" label="Search all calculators" size="lg" />
      </div>
    </div>

    <div class="border-t border-line pt-12">
      <h2 class="sr-only">All calculators</h2>
      <div class="gap-x-12 md:columns-2 lg:columns-3">
        {
          categories.map((category) => {
            const items = calculatorsIn(category.slug);
            return (
              <section class="mb-12 break-inside-avoid" aria-labelledby={`cat-${category.slug}`}>
                <h3
                  id={`cat-${category.slug}`}
                  class="flex items-baseline justify-between border-b-2 border-ink pb-2 text-xl"
                >
                  <a href={categoryUrl(category.slug)} class="hover:text-accent-ink">
                    {category.name}
                  </a>
                  <span class="rounded-full bg-accent px-2 py-0.5 text-xs font-medium tracking-normal text-on-accent tabular-nums">
                    {items.length}
                  </span>
                </h3>
                <ul class="divide-y divide-line">
                  {items.map((c) => (
                    <li class="py-3.5">
                      {c.status === 'live' ? (
                        <a
                          href={calculatorUrl(c)}
                          class="font-medium decoration-accent decoration-2 underline-offset-4 hover:underline"
                        >
                          {c.name}
                        </a>
                      ) : (
                        <span class="font-medium text-muted">
                          {c.name}
                          <span class="ml-2 text-xs font-normal">Coming soon</span>
                        </span>
                      )}
                      <p class="mt-0.5 text-[0.9375rem] leading-snug text-muted">{c.description}</p>
                    </li>
                  ))}
                </ul>
              </section>
            );
          })
        }
      </div>
    </div>

    <section class="mt-4 grid gap-8 border-t border-line pt-12 lg:grid-cols-[1fr_2fr]" aria-labelledby="about-site">
      <h2 id="about-site" class="text-2xl">About these calculators</h2>
      <div class="prose max-w-2xl">
        <p>
          Every calculator here runs in your browser. The numbers you type stay on your device, and nothing
          needs an account.
        </p>
        <p>
          Each page explains the formula in plain English, works through an example with real numbers, and
          answers the questions people most often ask about it. Where a result depends on a method or a local
          rule, such as the nisab standard for zakat, moon sighting for Hijri dates, or city and county sales
          tax, the page says so.
        </p>
        <p>
          <a href="/about/">How we build and check our calculators</a>
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
