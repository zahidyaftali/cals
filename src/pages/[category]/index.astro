---
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CalculatorCard from '../../components/CalculatorCard.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import { calculatorUrl, calculatorsIn, categories, categoryUrl, type Category } from '../../data/calculators';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { breadcrumbSchema, collectionPageSchema, type Crumb } from '../../lib/schema';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { category: category.slug }, props: { category } }));
}

interface Props {
  category: Category;
}
const { category } = Astro.props;
const path = categoryUrl(category.slug);
const items = calculatorsIn(category.slug);
const crumbs: Crumb[] = [{ name: 'Home', href: '/' }, { name: category.name }];
const others = categories.filter((c) => c.slug !== category.slug);

// Long lists get an in-feed ad after the first six cards; short lists get
// one ad after the list.
const firstBatch = items.slice(0, 6);
const rest = items.slice(6);

const jsonLd = [
  collectionPageSchema({
    name: category.h1,
    description: category.metaDescription,
    path,
    items: items.filter((c) => c.status === 'live').map((c) => ({ name: c.name, path: calculatorUrl(c) })),
  }),
  breadcrumbSchema(crumbs, path),
];
// Avoid a lone card on the last row: 1 card stays narrow, 2 or 4 use two
// columns, anything else three.
const gridClass = [
  'grid gap-3',
  items.length === 1
    ? 'max-w-xl'
    : items.length === 2 || items.length === 4
      ? 'sm:grid-cols-2'
      : 'sm:grid-cols-2 lg:grid-cols-3',
].join(' ');
---

<BaseLayout
  title={category.title}
  description={category.metaDescription}
  currentCategory={category.slug}
  jsonLd={jsonLd}
>
  <div class="wrap pt-5 sm:pt-6">
    <Breadcrumbs crumbs={crumbs} />
    <div class="max-w-2xl pt-4 pb-6 sm:pt-6 sm:pb-8">
      <h1 class="text-[2rem] leading-tight sm:text-[2.75rem]">{category.h1}</h1>
      <p class="mt-3 text-[1.0625rem] text-muted sm:text-lg">{category.intro}</p>
      <p class="mt-3 text-sm text-muted">
        {items.length}
        {items.length === 1 ? 'calculator' : 'calculators'}
      </p>
    </div>

    <ul class={gridClass}>
      {
        firstBatch.map((calculator) => (
          <li>
            <CalculatorCard calculator={calculator} headingLevel="h2" />
          </li>
        ))
      }
    </ul>

    <AdSlot unit="categoryList" format="banner" class="my-10" />

    {
      rest.length > 0 && (
        <ul class={gridClass}>
          {rest.map((calculator) => (
            <li>
              <CalculatorCard calculator={calculator} headingLevel="h2" />
            </li>
          ))}
        </ul>
      )
    }

    <nav aria-labelledby="other-categories" class="mt-12 border-t border-line pt-8">
      <h2 id="other-categories" class="text-xl">Other categories</h2>
      <ul class="mt-4 grid grid-cols-2 gap-2.5 sm:grid-cols-3 lg:grid-cols-6">
        {
          others.map((c) => (
            <li>
              <CategoryCard category={c} stacked />
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</BaseLayout>
