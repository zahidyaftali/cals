---
import Icon from '../components/Icon.astro';
import SiteSearch from '../components/SiteSearch.astro';
import { categories, categoryUrl } from '../data/calculators';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Infinite Calculators"
  description="The page you were looking for could not be found. Search for a calculator or browse the categories on Infinite Calculators."
  noindex
>
  <div class="wrap py-14 sm:py-20">
    <p class="font-semibold text-brand">Error 404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">We can't find that page</h1>
    <p class="mt-3 max-w-xl text-lg text-muted">
      The address may be mistyped, or the page may have moved. Search for the calculator you need, or pick
      a category below.
    </p>
    <div class="mt-8 max-w-xl">
      <SiteSearch id="notfound-search" label="Search calculators from this page" size="lg" />
    </div>

    <h2 class="mt-12 text-xl font-semibold">Browse by category</h2>
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        categories.map((c) => (
          <li>
            <a
              href={categoryUrl(c.slug)}
              class="inline-flex h-11 items-center gap-2 rounded-xl border border-line bg-surface px-4 font-medium hover:border-brand hover:text-brand"
            >
              <Icon name={c.slug} size={18} />
              {c.name}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-8">
      <a href="/" class="link font-medium">Go to the homepage</a>
    </p>
  </div>
</BaseLayout>
