---
import SiteSearch from '../components/SiteSearch.astro';
import { categories, categoryUrl } from '../data/calculators';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Infinite Calculators"
  description="The page you were looking for could not be found. Search for a calculator or browse the categories on Infinite Calculators."
  noindex
>
  <div class="wrap">
    <div class="max-w-2xl py-10 sm:py-20">
    <p class="text-sm font-medium text-muted">Error 404</p>
    <h1 class="mt-2 text-[2rem] leading-tight sm:text-[2.75rem]">We can't find that page</h1>
    <p class="mt-4 text-lg text-muted">
      The address may be mistyped, or the page may have moved. Search for the calculator you need, or pick a
      category below.
    </p>
    <div class="mt-7">
      <SiteSearch id="notfound-search" label="Search calculators from this page" size="lg" />
    </div>

    <h2 class="mt-12 text-sm font-medium tracking-normal text-muted">Categories</h2>
    <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
      {
        categories.map((c) => (
          <li>
            <a
              href={categoryUrl(c.slug)}
              class="inline-block py-1 font-medium decoration-accent decoration-2 underline-offset-4 hover:underline"
            >
              {c.name}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-10">
      <a href="/" class="btn btn-primary">Go to the homepage</a>
    </p>
    </div>
  </div>
</BaseLayout>
