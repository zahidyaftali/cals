---
// Layout for site pages (About, Contact, legal pages): breadcrumbs, H1,
// optional "last updated" line and a prose body.
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { formatDate } from '../data/site';
import { breadcrumbSchema, type Crumb } from '../lib/schema';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  h1: string;
  /** ISO date (YYYY-MM-DD) shown under the heading. */
  updated?: string;
}
const { title, description, h1, updated } = Astro.props;
const crumbs: Crumb[] = [{ name: 'Home', href: '/' }, { name: h1 }];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[breadcrumbSchema(crumbs, Astro.url.pathname)]}
>
  <article class="wrap pt-5 sm:pt-6">
    <Breadcrumbs crumbs={crumbs} />
    <header class="max-w-2xl border-b border-line pt-5 pb-6 sm:pt-8 sm:pb-8">
      <h1 class="text-[2rem] leading-tight sm:text-[2.75rem]">{h1}</h1>
      {
        updated && (
          <p class="mt-3 text-[0.9375rem] text-muted">
            Last updated <time datetime={updated}>{formatDate(updated)}</time>
          </p>
        )
      }
    </header>
    <div class="prose pt-8">
      <slot />
    </div>
  </article>
</BaseLayout>
