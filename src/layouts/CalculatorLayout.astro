---
// Page template for every calculator, in the order set by CLAUDE.md:
// breadcrumbs, H1 and intro → calculator → ad → content → FAQs → related
// calculators → last updated / reviewed by / disclaimer → feedback link.
import AdSlot from '../components/AdSlot.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQ, { type FaqItem } from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import RelatedCalculators from '../components/RelatedCalculators.astro';
import { calculatorsIn, calculatorUrl, categoryUrl, getCalculator, getCategory, popularCalculators } from '../data/calculators';
import { formatDate, site } from '../data/site';
import { breadcrumbSchema, faqSchema, webApplicationSchema, type Crumb } from '../lib/schema';
import BaseLayout from './BaseLayout.astro';

interface Props {
  slug: string;
  /** One sentence under the H1. */
  intro: string;
  faqs: FaqItem[];
  /** Short note shown at the foot of the page, e.g. "Results are a guide…". */
  disclaimer?: string;
}

const { slug, intro, faqs, disclaimer } = Astro.props;
const calc = getCalculator(slug);
const category = getCategory(calc.category);
const path = calculatorUrl(calc);
const crumbs: Crumb[] = [
  { name: 'Home', href: '/' },
  { name: category.name, href: categoryUrl(category.slug) },
  { name: calc.name },
];
const jsonLd = [
  webApplicationSchema({ name: calc.name, description: calc.metaDescription, path, dateModified: calc.updated }),
  faqSchema(faqs),
  breadcrumbSchema(crumbs, path),
];
// Sidebar links (desktop): the rest of this category, then popular calculators
// not already listed.
const siblings = calculatorsIn(calc.category).filter((c) => c.slug !== calc.slug && c.status === 'live');
const popular = popularCalculators
  .filter((c) => c.slug !== calc.slug && c.status === 'live' && !siblings.includes(c))
  .slice(0, 6);
const reportHref = `mailto:${site.email}?subject=${encodeURIComponent(`Result check: ${calc.name}`)}&body=${encodeURIComponent(
  `Page: ${new URL(path, site.url).href}\n\nValues I entered:\n\nResult shown:\n\nResult I expected:\n`,
)}`;
---

<BaseLayout title={calc.title} description={calc.metaDescription} currentCategory={calc.category} jsonLd={jsonLd}>
  <article class="wrap pt-4 sm:pt-6">
    <Breadcrumbs crumbs={crumbs} />
    <header class="max-w-3xl pt-2 pb-5 sm:pt-4 sm:pb-6">
      <h1 class="text-[1.75rem] leading-tight sm:text-[2.5rem]">{calc.name}</h1>
      <p class="mt-2 text-muted sm:text-lg">{intro}</p>
    </header>

    <section aria-label={`${calc.name} tool`}>
      <slot />
    </section>

    <AdSlot unit="calculatorTop" format="banner" class="mt-10 mb-0" />

    <div class="mt-10 grid gap-12 sm:mt-12 lg:grid-cols-[minmax(0,1fr)_17.5rem] lg:gap-14">
      <div class="min-w-0">
        <div class="prose">
          <slot name="content" />
        </div>
        <div class="max-w-3xl">
          <FAQ items={faqs} />
        </div>
      </div>

      <aside class="hidden lg:block" aria-label="More calculators">
        <div class="sticky top-6 space-y-5">
          {
            siblings.length > 0 && (
              <nav class="soft-card p-5" aria-labelledby="side-category">
                <h2 id="side-category" class="text-base tracking-[-0.01em]">
                  More {category.name} calculators
                </h2>
                <ul class="mt-3 space-y-0.5">
                  {siblings.map((c) => (
                    <li>
                      <a href={calculatorUrl(c)} class="side-link">
                        <Icon name={c.category} size={16} class="shrink-0 text-accent-ink" />
                        <span>{c.name}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )
          }
          <nav class="soft-card p-5" aria-labelledby="side-popular">
            <h2 id="side-popular" class="text-base tracking-[-0.01em]">Popular calculators</h2>
            <ul class="mt-3 space-y-0.5">
              {popular.map((c) => (
                <li>
                  <a href={calculatorUrl(c)} class="side-link">
                    <Icon name={c.category} size={16} class="shrink-0 text-accent-ink" />
                    <span>{c.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </aside>
    </div>

    <AdSlot unit="calculatorBottom" format="rectangle" class="mt-10 mb-0" />

    <RelatedCalculators calculator={calc} />

    <footer class="mt-12 max-w-3xl space-y-2 border-t border-line pt-6 text-[0.9375rem] text-muted">
      <p>
        Last updated <time datetime={calc.updated}>{formatDate(calc.updated)}</time>
        {
          calc.reviewer && (
            <>
              {' · '}Reviewed by{' '}
              {calc.reviewer.url ? (
                <a href={calc.reviewer.url} class="link">
                  {calc.reviewer.name}
                </a>
              ) : (
                <span class="text-ink">{calc.reviewer.name}</span>
              )}
              {calc.reviewer.credentials && <>, {calc.reviewer.credentials}</>}
            </>
          )
        }
      </p>
      {disclaimer && <p>{disclaimer}</p>}
      <p>
        Is this result wrong? <a href={reportHref} class="link">Tell us</a> and we'll check it. How we build and
        test calculators is set out in our <a href="/editorial-policy/" class="link">editorial policy</a>.
      </p>
    </footer>
  </article>
</BaseLayout>
