---
export interface FaqItem {
  q: string;
  a: string;
}
interface Props {
  items: FaqItem[];
}
const { items } = Astro.props;
---

<section aria-labelledby="faq-title" class="mt-12">
  <h2 id="faq-title" class="text-2xl">Frequently asked questions</h2>
  <div class="mt-5 divide-y divide-line border-y border-line">
    {
      items.map((item) => (
        <div class="py-5">
          <h3 class="text-[1.0625rem] leading-snug tracking-[-0.01em]">{item.q}</h3>
          <p class="mt-2 text-[color-mix(in_srgb,var(--ink)_82%,var(--muted))]">{item.a}</p>
        </div>
      ))
    }
  </div>
</section>
