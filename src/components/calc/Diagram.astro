---
// Small labelled line drawings that show what each measurement means, like
// the shape pictures on paper forms. Decorative: the fields have their own labels.
interface Props {
  name: keyof typeof shapes;
  mode?: string;
  /** Render as a <template> for scripts to copy (square footage rows). */
  template?: boolean;
}

const shapes = {
  slab: `
    <polygon class="dg-top" points="30,56 140,56 180,32 70,32"/>
    <polygon class="dg-face" points="30,56 140,56 140,88 30,88"/>
    <polygon class="dg-side" points="140,56 180,32 180,64 140,88"/>
    <text class="dg-label" x="85" y="106" text-anchor="middle">Length</text>
    <text class="dg-label" x="168" y="24" text-anchor="middle">Width</text>
    <text class="dg-label" x="186" y="76">Thickness</text>`,
  column: `
    <path class="dg-face" d="M70 30 V104 A40 10 0 0 0 150 104 V30 Z"/>
    <ellipse class="dg-top" cx="110" cy="30" rx="40" ry="10"/>
    <line class="dg-dim" x1="70" y1="30" x2="150" y2="30"/>
    <text class="dg-label" x="110" y="14" text-anchor="middle">Diameter</text>
    <line class="dg-dim" x1="166" y1="30" x2="166" y2="104"/>
    <text class="dg-label" x="172" y="71">Height</text>`,
  tube: `
    <path class="dg-face" d="M70 30 V104 A40 10 0 0 0 150 104 V30 Z"/>
    <ellipse class="dg-top" cx="110" cy="30" rx="40" ry="10"/>
    <ellipse class="dg-hole" cx="110" cy="30" rx="24" ry="6"/>
    <text class="dg-label" x="110" y="14" text-anchor="middle">Outer diameter</text>
    <text class="dg-label" x="110" y="58" text-anchor="middle">Inner diameter</text>
    <line class="dg-dim" x1="86" y1="30" x2="134" y2="30"/>
    <line class="dg-dim" x1="166" y1="30" x2="166" y2="104"/>
    <text class="dg-label" x="172" y="71">Height</text>`,
  stairs: `
    <polygon class="dg-face" points="30,118 30,94 70,94 70,70 110,70 110,46 180,46 180,118"/>
    <text class="dg-label" x="24" y="110" text-anchor="end">Rise</text>
    <text class="dg-label" x="50" y="88" text-anchor="middle">Run</text>
    <text class="dg-label" x="145" y="40" text-anchor="middle">Platform depth</text>
    <text class="dg-note" x="105" y="134" text-anchor="middle">Side view. Width runs into the page.</text>`,
  posthole: `
    <line class="dg-ground" x1="20" y1="40" x2="220" y2="40"/>
    <rect class="dg-face" x="80" y="40" width="80" height="80" rx="4"/>
    <rect class="dg-post" x="108" y="10" width="24" height="110"/>
    <line class="dg-dim" x1="80" y1="130" x2="160" y2="130"/>
    <text class="dg-label" x="120" y="145" text-anchor="middle">Hole diameter</text>
    <line class="dg-dim" x1="172" y1="40" x2="172" y2="120"/>
    <text class="dg-label" x="178" y="84">Depth</text>
    <text class="dg-label" x="102" y="22" text-anchor="end">Post</text>`,
  rectangle: `
    <rect class="dg-face" x="40" y="20" width="120" height="70" rx="2"/>
    <text class="dg-label" x="100" y="108" text-anchor="middle">Length</text>
    <text class="dg-label" x="168" y="59">Width</text>`,
  lshape: `
    <polygon class="dg-face" points="30,20 150,20 150,58 102,58 102,94 30,94"/>
    <rect class="dg-cut" x="102" y="58" width="48" height="36"/>
    <text class="dg-label" x="90" y="112" text-anchor="middle">Overall length</text>
    <text class="dg-label" x="158" y="42">Overall width</text>
    <text class="dg-note" x="126" y="80" text-anchor="middle">Cut-out</text>`,
  triangle: `
    <polygon class="dg-face" points="40,94 160,94 92,20"/>
    <line class="dg-line" x1="92" y1="20" x2="92" y2="94"/>
    <text class="dg-label" x="100" y="112" text-anchor="middle">Base</text>
    <text class="dg-label" x="86" y="64" text-anchor="end">Height</text>`,
  circle: `
    <circle class="dg-face" cx="100" cy="58" r="40"/>
    <line class="dg-dim" x1="60" y1="58" x2="140" y2="58"/>
    <text class="dg-label" x="100" y="52" text-anchor="middle">Diameter</text>`,
  semicircle: `
    <path class="dg-face" d="M60 86 A40 40 0 0 1 140 86 Z"/>
    <text class="dg-label" x="100" y="104" text-anchor="middle">Diameter</text>`,
  trapezoid: `
    <polygon class="dg-face" points="40,94 160,94 134,24 66,24"/>
    <line class="dg-line" x1="100" y1="24" x2="100" y2="94"/>
    <text class="dg-label" x="100" y="112" text-anchor="middle">Parallel side 1</text>
    <text class="dg-label" x="100" y="16" text-anchor="middle">Parallel side 2</text>
    <text class="dg-label" x="106" y="64">Height</text>`,
  room: `
    <polygon class="dg-top" points="40,46 150,46 194,22 84,22"/>
    <polygon class="dg-face" points="40,46 150,46 150,116 40,116"/>
    <polygon class="dg-side" points="150,46 194,22 194,92 150,116"/>
    <rect class="dg-cut" x="58" y="78" width="22" height="38"/>
    <rect class="dg-cut" x="100" y="62" width="30" height="22"/>
    <text class="dg-label" x="95" y="132" text-anchor="middle">Length</text>
    <text class="dg-label" x="178" y="16" text-anchor="middle">Width</text>
    <text class="dg-label" x="200" y="74">Height</text>`,
} as const;

const { name, mode, template = false } = Astro.props;
const svg = `<svg viewBox="0 0 240 150" width="240" height="150" aria-hidden="true" focusable="false">${shapes[name]}</svg>`;
---

{
  template ? (
    <template data-diagram={name} set:html={svg}></template>
  ) : (
    <figure class="calc-diagram f-full" data-mode={mode} set:html={svg}></figure>
  )
}
