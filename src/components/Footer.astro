---
import { categories, categoryUrl } from '../data/calculators';
import { site } from '../data/site';
import Logo from './Logo.astro';

const sitePages = [
  { name: 'About', href: '/about/' },
  { name: 'Editorial Policy', href: '/editorial-policy/' },
  { name: 'Contact', href: '/contact/' },
  { name: 'Privacy Policy', href: '/privacy-policy/' },
  { name: 'Terms of Use', href: '/terms/' },
  { name: 'Disclaimer', href: '/disclaimer/' },
];
const year = new Date().getFullYear();
---

<footer class="mt-16 bg-deep text-on-deep sm:mt-24">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-10 py-12 sm:py-14 lg:grid-cols-[2fr_1fr_1fr]">
    <div class="col-span-2 max-w-sm lg:col-span-1">
      <a href="/" class="inline-flex items-center gap-2.5 font-semibold tracking-tight">
        <Logo size={28} />
        <span>{site.name}</span>
      </a>
      <p class="mt-4 font-medium">{site.tagline}</p>
      <p class="mt-2 text-[0.9375rem] text-on-deep/70">
        Free calculators that run in your browser. Nothing you enter is sent to our server.
      </p>
      <p class="mt-4 text-[0.9375rem] text-on-deep/70">
        Found a mistake?
        <a href="/contact/" class="font-medium text-accent underline-offset-4 hover:underline">Tell us</a>
        and we'll check it.
      </p>
    </div>

    <nav aria-labelledby="footer-categories">
      <h2 id="footer-categories" class="text-sm font-medium tracking-normal text-on-deep/50">Calculators</h2>
      <ul class="mt-3 space-y-0.5">
        {
          categories.map((c) => (
            <li>
              <a href={categoryUrl(c.slug)} class="inline-block py-1 text-[0.9375rem] hover:text-accent">
                {c.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-labelledby="footer-site">
      <h2 id="footer-site" class="text-sm font-medium tracking-normal text-on-deep/50">Site</h2>
      <ul class="mt-3 space-y-0.5">
        {
          sitePages.map((p) => (
            <li>
              <a href={p.href} class="inline-block py-1 text-[0.9375rem] hover:text-accent">
                {p.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="border-t border-on-deep/10">
    <div class="wrap flex flex-col gap-1 py-5 text-sm text-on-deep/60 sm:flex-row sm:justify-between sm:gap-6">
      <p>
        © {year} {site.name} · Owned &amp; operated by
        <a href={site.owner.url} class="text-on-deep/85 underline underline-offset-4 hover:text-accent">{site.owner.name}</a>
      </p>
      <p>
        Results are estimates for information only. See our
        <a href="/disclaimer/" class="text-on-deep/85 underline underline-offset-4 hover:text-accent">disclaimer</a>.
      </p>
    </div>
  </div>
</footer>
