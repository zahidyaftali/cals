---
// One AdSense unit with a fixed, reserved size (see .ad-unit in global.css).
// Renders nothing until ads are switched on in src/data/site.ts.
import { site } from '../data/site';

interface Props {
  /** Which ad unit ID to use (site.ads.units). */
  unit: keyof typeof site.ads.units;
  /** banner: 300×250 on phones, 728×90 from 768px. rectangle: 300×250, then 336×280. */
  format?: 'banner' | 'rectangle';
  class?: string;
}
const { unit, format = 'rectangle', class: className } = Astro.props;
const { enabled, client, units } = site.ads;
---

{
  enabled && (
    <aside aria-label="Advertisement" class:list={['ad', `ad-${format}`, className]}>
      <p class="ad-label">Advertisement</p>
      <ins class="adsbygoogle ad-unit" data-ad-client={client} data-ad-slot={units[unit]}></ins>
      <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
    </aside>
  )
}
