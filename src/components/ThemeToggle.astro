---
import Icon from './Icon.astro';

interface Props {
  /** Show "Dark mode" / "Light mode" text next to the icon (used in the mobile menu). */
  withLabel?: boolean;
  class?: string;
}
const { withLabel = false, class: className } = Astro.props;
---

{
  withLabel ? (
    <button
      type="button"
      class:list={[
        'inline-flex h-10 items-center gap-2 rounded-lg px-3 text-[0.9375rem] font-medium hover:bg-surface-2',
        className,
      ]}
      data-theme-toggle
    >
      <Icon name="moon" size={18} class="dark:hidden" />
      <Icon name="sun" size={18} class="hidden dark:block" />
      <span class="dark:hidden">Dark mode</span>
      <span class="hidden dark:inline">Light mode</span>
    </button>
  ) : (
    <button
      type="button"
      class:list={['icon-btn', className]}
      aria-label="Switch to dark mode"
      data-theme-toggle
      data-theme-icon-only
    >
      <Icon name="moon" size={20} class="dark:hidden" />
      <Icon name="sun" size={20} class="hidden dark:block" />
    </button>
  )
}

<script>
  // The starting theme is set by the inline script in BaseLayout's <head>.
  const root = document.documentElement;
  const media = matchMedia('(prefers-color-scheme: dark)');

  function apply(dark: boolean) {
    root.classList.toggle('dark', dark);
    for (const button of document.querySelectorAll('[data-theme-icon-only]')) {
      button.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
    }
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', getComputedStyle(root).getPropertyValue('--bg').trim());
  }

  apply(root.classList.contains('dark'));

  for (const button of document.querySelectorAll('[data-theme-toggle]')) {
    button.addEventListener('click', () => {
      const dark = !root.classList.contains('dark');
      apply(dark);
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch {
        // Storage blocked (private mode): the choice lasts for this page only.
      }
    });
  }

  // Keep following the system setting until the visitor picks a theme.
  media.addEventListener('change', (e) => {
    let saved: string | null = null;
    try {
      saved = localStorage.getItem('theme');
    } catch {}
    if (!saved) apply(e.matches);
  });
</script>
