---
// Brand mark: a deep-green equals sign on a lime tile ("the answer"). The same
// drawing is used for public/favicon.svg and the PNG icons.
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 32 32"
  width={size}
  height={size}
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <rect width="32" height="32" rx="8" fill="#b0ec6c"></rect>
  <rect x="8.5" y="10.5" width="15" height="3.6" rx="1.8" fill="#182c04"></rect>
  <rect x="8.5" y="17.9" width="15" height="3.6" rx="1.8" fill="#182c04"></rect>
</svg>
