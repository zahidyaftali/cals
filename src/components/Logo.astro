---
// Brand mark: a deep-green infinity loop on a lime tile. The same drawing is
// used for public/favicon.svg.
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 32 32"
  width={size}
  height={size}
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <rect width="32" height="32" rx="8" fill="#b0ec6c"></rect>
  <path
    d="M16 16c-2-2.67-4-4-6-4a4 4 0 1 0 0 8c2 0 4-1.33 6-4Zm0 0c2 2.67 4 4 6 4a4 4 0 0 0 0-8c-2 0-4 1.33-6 4Z"
    fill="none"
    stroke="#182c04"
    stroke-width="2.6"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
